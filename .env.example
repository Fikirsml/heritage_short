# Copy to .env and fill in real values. .env is gitignored.

# Google Gemini — story/script generation (and possibly images)
GEMINI_API_KEY=

# Cloudflare — Workers AI (TTS/images) and/or R2 storage
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Cloudflare keyframe image model
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Colab handoff: path to a Google-Drive-synced exchange folder (see COLAB.md).
# If unset, ./exchange is used locally and must be uploaded to Drive manually.
DRIVE_EXCHANGE_DIR=
