{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeritageShortStoryboard",
  "type": "object",
  "required": ["title", "narration", "music", "shots"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "target_duration_seconds": {
      "type": "number",
      "minimum": 60,
      "maximum": 90,
      "description": "Target film length for the assignment (60-90s)."
    },
    "narration": {
      "type": "object",
      "required": ["script"],
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1,
          "description": "First-person English narration text (~150-220 words for 60-90s)."
        },
        "voice": {
          "type": "string",
          "default": "Kore",
          "description": "Gemini prebuilt TTS voice name."
        },
        "model": {
          "type": "string",
          "description": "Gemini TTS model id. Falls back to GEMINI_TTS_MODEL env."
        }
      }
    },
    "music": {
      "type": "object",
      "required": ["prompt", "duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "model": {
          "type": "string",
          "default": "facebook/musicgen-small",
          "description": "Music model id used by the Colab GPU job."
        },
        "seed": {
          "type": "integer",
          "description": "Optional seed for reproducible generation."
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "duration_seconds"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Used as filename stem: keyframes/<id>.png, shots/<id>.mp4."
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Visual description used for keyframe + video generation."
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "negative_prompt": {
            "type": "string",
            "description": "Optional negative prompt for video generation."
          },
          "video": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {"type": "string"},
              "width": {"type": "integer", "exclusiveMinimum": 0},
              "height": {"type": "integer", "exclusiveMinimum": 0},
              "frames": {"type": "integer", "exclusiveMinimum": 0},
              "steps": {"type": "integer", "exclusiveMinimum": 0},
              "guidance": {"type": "number", "exclusiveMinimum": 0},
              "seed": {"type": "integer"}
            }
          }
        }
      }
    }
  }
}
